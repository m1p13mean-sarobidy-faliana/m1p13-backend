{
  "name": "@m1p13/client",
  "version": "1.0.0",
  "main": "./dist/index.js",
  "module": "./index.ts",
  "typings": "./dist/index.d.ts",
    "keywords": [
    "typescript",
    "kubb generator",
    "openapi-client",
    "typescript-angular"
  ],
  "scripts": {
    "build": "tsc",
    "generate": "npx kubb -c kubb.config.ts",
    "ng:gen": "npx openapi-generator-cli generate -i ../docs/api.yml -g typescript-angular -o ./",
    "format": "prettier --write ./"
  },
  "devDependencies": {
    "@kubb/cli": "^4.24.0",
    "@kubb/core": "^4.24.0",
    "@kubb/plugin-oas": "^4.24.0",
    "@kubb/plugin-ts": "^4.24.0",
    "@kubb/plugin-zod": "^4.24.0",
    "@openapitools/openapi-generator-cli": "^2.29.0"
  },
  "dependencies": {
    "@angular/common": "^21.1.5",
    "@angular/core": "^21.1.5",
    "prettier": "^3.8.1",
    "prettier-plugin-organize-imports": "^4.3.0",
    "zod": "^4.3.6"
  },
    "publishConfig": {
    "registry": "https://npm.pkg.github.com/"
  }
}
